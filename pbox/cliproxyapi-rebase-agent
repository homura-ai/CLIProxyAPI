#!/usr/bin/env python3
"""Start a T3 agent to fix the model-priority patch when the fork's sync fails.

Runs hourly from cliproxyapi-rebase-agent.timer on pbox. For each open
"sync-upstream failed for <tag>" issue on the fork, it reads the failing patch
head that the workflow recorded (head=<sha>) and starts one agent per failing
head, at most MAX_LAUNCHES per issue, and never while an earlier agent for that
issue is still running. Costs nothing when no issue is open.
"""
import json, os, re, subprocess, sys, pathlib

REPO = os.environ.get("CPA_UPDATE_REPO", "homura-ai/CLIProxyAPI")
PROJECT = os.environ.get("CPA_REBASE_PROJECT", "/home/vi/code/reuse/cliproxyapi")
T3 = "/home/vi/.t3/bin/t3"
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "cliproxyapi-rebase-agent"
MAX_LAUNCHES = 3
DRY = "--dry-run" in sys.argv

BRIEF = """You are the CLIProxyAPI auto-rebase agent, started by the pbox timer cliproxyapi-rebase-agent.

Job: make the fork's sync succeed again. Issue: https://github.com/{repo}/issues/{issue} ("{title}"). Failing patch head: {head}.

Background:
- The fork {repo} keeps one commit on branch `model-priority` on top of the latest upstream router-for-me/CLIProxyAPI release.
- That commit adds per-model credential priority (`model_priority` in auth files). See the README section it adds, and the commit itself (`git show model-priority`), for the intended behaviour.
- The `automation` branch holds .github/workflows/sync-upstream.yml. Every hour it rebases the branch onto the latest release, tests it, and publishes a `v<upstream>-mp.<n>` release, which pbox installs automatically.
- Its test gate fails only on repeatable failures that unmodified upstream does not also have.

Steps:
1. Read the issue and its latest comment. Run `gh run view <run id> --log-failed -R {repo}` to see why it failed: a rebase conflict, or a test, build or release failure.
2. In {project} (a checkout of the fork; the `upstream` remote is router-for-me/CLIProxyAPI):
   - run `git fetch origin && git fetch upstream --tags`
   - check out `model-priority` and reset it to origin/model-priority
   - rebase it onto the upstream release named in the issue title, keeping exactly one commit
   - resolve conflicts so the behaviour is unchanged, and port the effective per-model priority to any new place upstream orders or buckets credentials by priority (`git log -p <old tag>..<new tag> -- sdk/cliproxy/auth`)
   - for a test failure, fix the patch. Never edit, skip or weaken a test to make it pass.
3. Validate on a boat.dev `large` machine (`boat --help`):
   - `bash .github/scripts/refresh-model-catalogs.sh`
   - `go vet ./sdk/cliproxy/auth/...`
   - the tests for the touched packages
   - `go build ./cmd/server`
   - `go test ./...`
   Compare any failure against an unmodified checkout of the same upstream tag. Delete the machine afterwards. Never run builds or tests on pbox.
4. Run the review-loop skill with a fresh Sol reviewer on the new commit, and get its approval.
5. `git push --force-with-lease origin model-priority`. The next hourly sync run releases it.
6. Comment on the issue with what changed and the new SHA, then close it. Every comment must start with:
   > [!NOTE]
   > 🤖 **<your model> responding on behalf of @01-1**
7. Verify `gh issue view {issue} -R {repo} --json state --jq .state` returns `CLOSED`, then call `t3_thread_organize` with `action: "settle"` and omit `threadId` to settle this thread. Do this for successful repairs and no-change resolutions. Leave the thread unsettled if the issue is still open or the repair is blocked.

Rules:
- Never send requests to Anthropic or to the local proxies on ports 8317 and 8318.
- Don't touch the `automation` branch, the live proxy binary, or ~/.cli-proxy-api*.
- If the upstream change makes per-model priority impossible to port faithfully, leave the issue open, comment why, and stop.
"""


def sh(*args, **kw):
    return subprocess.run(args, check=True, capture_output=True, text=True, **kw).stdout


def running(thread_id):
    try:
        data = json.loads(sh(T3, "thread", "show", thread_id, "--messages", "0", "--json"))
    except Exception:
        return False
    t = data.get("thread", data)
    return t.get("status") == "running" or bool(t.get("activeRunId"))


def main():
    STATE.mkdir(parents=True, exist_ok=True)
    issues = json.loads(sh("gh", "issue", "list", "-R", REPO, "--state", "open", "--search",
                           '"sync-upstream failed for" in:title', "--json", "number,title,body,comments"))
    if not issues:
        print("no open sync failure issues")
        return
    for issue in issues:
        n = issue["number"]
        texts = [issue["body"]] + [c["body"] for c in issue["comments"]]
        heads = [m for t in texts for m in re.findall(r"head=([0-9a-f]{40})", t)]
        head = heads[-1] if heads else "unknown"
        state_file = STATE / f"{n}.json"
        state = json.loads(state_file.read_text()) if state_file.exists() else {"launches": []}
        launches = state["launches"]
        if any(running(l["thread"]) for l in launches if l.get("thread")):
            print(f"#{n}: an agent is still working on it")
            continue
        if any(l["head"] == head for l in launches):
            print(f"#{n}: an agent already handled head {head[:12]}")
            continue
        if len(launches) >= MAX_LAUNCHES:
            print(f"#{n}: {MAX_LAUNCHES} agents already tried; leaving it for Homura")
            continue
        brief = BRIEF.format(repo=REPO, issue=n, title=issue["title"], head=head, project=PROJECT)
        cmd = [T3, "thread", "start", "--json", "--provider", "codex", "--model", "gpt-6.2-sol",
               "--option", "reasoningEffort=xhigh", "--title", f"CLIProxyAPI auto-rebase: #{n}",
               "--client-request-id", f"cpa-rebase-{n}-{head[:12]}", PROJECT, "-"]
        if DRY:
            print(f"#{n}: would start agent for head {head[:12]}")
            continue
        out = sh(*cmd, input=brief)
        try:
            thread = json.loads(out).get("threadId") or json.loads(out).get("id")
        except Exception:
            thread = out.strip().split()[-1] if out.strip() else None
        launches.append({"head": head, "thread": thread})
        state_file.write_text(json.dumps(state, indent=2))
        print(f"#{n}: started agent {thread} for head {head[:12]}")


if __name__ == "__main__":
    main()
